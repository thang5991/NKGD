# Optional: use the official Trading Economics calendar provider.
# Create a key at https://tradingeconomics.com/api/
TRADING_ECONOMICS_API_KEY=

# Required: password requested every time the app is opened or reloaded.
# Use at least 6 characters. Keep the real value only in .env.
NKGD_APP_PASSWORD=change-this-password

# Optional production port (default: 3000)
PORT=3000
